{
  "manifest_version": 3,
  "name": "BGer Reader",
  "version": "0.11.1",
  "description": "Lesbarkeit fuer Entscheide des Bundesgerichts (bger.ch) und Bundesverwaltungsgerichts (bvger.weblaw.ch). 100 % offline, keine Daten.",
  "minimum_chrome_version": "121",
  "content_scripts": [
    {
      "matches": [
        "https://search.bger.ch/*",
        "https://relevancy.bger.ch/*",
        "http://relevancy.bger.ch/*",
        "https://bvger.weblaw.ch/*"
      ],
      "js": ["sprachen.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BGer Reader Einstellungen oeffnen",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bger-reader@bge.reader",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": [
        "https://search.bger.ch/*",
        "https://relevancy.bger.ch/*",
        "http://relevancy.bger.ch/*",
        "https://bvger.weblaw.ch/*"
      ]
    }
  ]
}
